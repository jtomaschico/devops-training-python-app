pipeline {
  // `agent any` = el pipeline se ejecuta en cualquier nodo/agente disponible.
  agent any

  agent {
    docker { 
        image 'python:3.6-slim'
        args '-u root' 
    }
  }

  stages {
    stage('Info') {
      steps {
        echo "Job: ${env.JOB_NAME}"
        echo "Build: ${env.BUILD_NUMBER}"
      }
    }
    stage('Prepare') {
       steps {
          sh 'apt-get update && apt-get install -y make'
          sh 'pip install -r requirements.txt'
       }
    }
    stage('CI - Lint') {
      steps {
         sh 'make lint'
      }
    }
      
    stage('CI - Test') {
      steps {
         h 'pytest -q'
      }
    }
  }
} 
