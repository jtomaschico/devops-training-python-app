pipeline {
  // `agent any` = el pipeline se ejecuta en cualquier nodo/agente disponible.
  agent any

  environment {
    PYTHON_TEST_IMAGE = 'python:3.6-slim'
  }  

  stages {
    stage('Info') {
      steps {
        echo "Job: ${env.JOB_NAME}"
        echo "Build: ${env.BUILD_NUMBER}"
      }
    }
    stage('CI - Test') {
      steps {
        script {
          runInDocker(env.PYTHON_TEST_IMAGE) {
            sh 'pip install -r requirements.txt'
            sh 'pytest -q'
          }
        }
      }
    }
  }
} 
